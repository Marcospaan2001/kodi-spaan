<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.spaan" name="Spaan Repository" version="1.0.0" provider-name="Spaan">
    <extension point="xbmc.addon.repository" name="Spaan Repository">
        <!-- Eigen addons (skin-mod), gehost via GitHub Pages -->
        <dir>
            <info compressed="false">https://marcospaan2001.github.io/kodi-spaan/zips/addons.xml</info>
            <checksum>https://marcospaan2001.github.io/kodi-spaan/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://marcospaan2001.github.io/kodi-spaan/zips/</datadir>
        </dir>
        <!-- Afhankelijkheden van de skin (TMDbHelper, skinvariables, texturemaker):
             rechtstreeks uit de repository van jurialmunkey, niet door ons gehost.
             Overgenomen uit repository.jurialmunkey 3.6. -->
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/</datadir>
        </dir>
        <dir minversion="20.9.1">
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/</datadir>
        </dir>
        <dir minversion="21.90.901">
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/piers/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/piers/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/piers/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Spaan Repository</summary>
        <summary lang="nl">Spaan Repository</summary>
        <description lang="en">Personal repository with the Spaan skin mod and the add-ons it depends on.</description>
        <description lang="nl">Persoonlijke repository met de Spaan skin-mod en de add-ons waar die van afhangt.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
