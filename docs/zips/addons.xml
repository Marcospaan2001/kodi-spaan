<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.spaan" name="Spaan Repository" version="1.0.6" provider-name="Spaan">
    <extension point="xbmc.addon.repository" name="Spaan Repository">
        <!-- Eigen addons (skin-mod), gehost via GitHub Pages -->
        <dir>
            <info compressed="false">https://marcospaan2001.github.io/kodi-spaan/zips/addons.xml</info>
            <checksum>https://marcospaan2001.github.io/kodi-spaan/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://marcospaan2001.github.io/kodi-spaan/zips/</datadir>
        </dir>
        <!-- Afhankelijkheden van de skin (TMDbHelper, skinvariables, texturemaker):
             rechtstreeks uit de repository van jurialmunkey, niet door ons gehost.
             Overgenomen uit repository.jurialmunkey 3.6. -->
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/</datadir>
        </dir>
        <dir minversion="20.9.1">
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/</datadir>
        </dir>
        <dir minversion="21.90.901">
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/piers/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/piers/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/piers/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Spaan Repository</summary>
        <summary lang="nl">Spaan Repository</summary>
        <description lang="en">Personal repository with Familie Krispijn skins for Kodi 21 and 22 and their dependencies.</description>
        <description lang="nl">Persoonlijke repository met Familie Krispijn voor Kodi 21 en 22 en de benodigde add-ons.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="plugin.video.krispijn" version="1.0.2" name="Krispijn Video" provider-name="Spaan, gebaseerd op kodifitzwell POV">
	<requires>
		<import addon="xbmc.python" version="3.0.0" />
		<import addon="script.module.requests" />
	</requires>
	<extension point="xbmc.python.pluginsource" library="resources/lib/router.py">
		<provides>video</provides>
	</extension>
	<extension point="xbmc.service" library="resources/lib/service.py" />
	<extension point="xbmc.python.module" library="lib/" />
	<extension point="xbmc.addon.metadata">
		<reuselanguageinvoker>true</reuselanguageinvoker>
		<license>GNU GENERAL PUBLIC LICENSE. Version 3, 29 June 2007</license>
		<disclaimer lang="en">The author of this addon does not host any of the content which is found and has no affiliation with any of the content providers.[CR]The author is in no way affiliated with Kodi, Team Kodi, or the XBMC Foundation.</disclaimer>
		<summary>Films en series voor Familie Krispijn</summary>
		<description lang="en">This is a Non-profit resource, organized solely for educational purposes which is protected under the Fair-Use doctrine of the Copyright Act, Specifically section 107, which does promote freedom of expression, by permitting the unlicensed use of copyright-protected works.</description>
		<news>INFO: For latest changes see Changelog within add-on.</news>
		<assets><icon>icon.png</icon><fanart>fanart.jpg</fanart></assets>
	</extension>
</addon>
<addon id="skin.arctic.fuse.2.krispijn" name="Familie Krispijn (Kodi 21)" provider-name="jurialmunkey (mod: Krispijn)" version="1.0.3">
    <requires>
        <import addon="xbmc.gui" version="5.17.0" />
        <import addon="script.skinvariables" version="2.1.28" />
        <import addon="script.texturemaker" version="0.2.9" />
        <import addon="plugin.video.themoviedb.helper" version="6.12.1" />
        <import addon="resource.images.weathericons.white" version="0.0.1" />
        <import addon="resource.images.studios.coloured" version="0.0.1" />
        <import addon="resource.font.robotocjksc" version="0.0.3" />
    </requires>
    <extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
        <res aspect="16:9" default="true" folder="1080i" width="1920" height="1080" />
        <res aspect="3:2" default="false" folder="1080i" width="1620" height="1080" />
        <res aspect="4:3" default="false" folder="1080i" width="1440" height="1080" />
        <res aspect="16:10" default="false" folder="1080i" width="1728" height="1080" />
        <res aspect="17:9" default="false" folder="1080i" width="2040" height="1080" />
        <res aspect="21:9" default="false" folder="1080i" width="2520" height="1080" />
        <res aspect="19.5:9" default="false" folder="1080i" width="2340" height="1080" />
        <res aspect="18:9" default="false" folder="1080i" width="2160" height="1080" />
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Familie Krispijn (Kodi 21): a family mod of Arctic Fuse 2</summary>
        <summary lang="nl">Familie Krispijn (Kodi 21): gezinsmod van Arctic Fuse 2</summary>
        <description lang="en">Familie Krispijn (Kodi 21) is a personal mod of Arctic Fuse 2 2.12.12 by jurialmunkey (CC BY-NC-SA 4.0): own colours, logo, startup screen and family faces.</description>
        <description lang="nl">Familie Krispijn (Kodi 21) is een persoonlijke mod van Arctic Fuse 2 2.12.12 van jurialmunkey (CC BY-NC-SA 4.0): eigen kleuren, logo, opstartscherm en gezinsgezichtjes.</description>
        <platform>all</platform>
        <license>Creative Commons Attribution Non-Commercial Share-Alike 4.0</license>
        <forum />
        <source />
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
